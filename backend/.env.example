# TrueTransit Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (SQLite for local zero-daemon run, or postgresql://user:password@localhost:5432/truetransit)
DATABASE_URL="file:./dev.db"

# Security & Authentication
JWT_SECRET=truetransit_development_jwt_secret_key_987654321
JWT_EXPIRES_IN=7d

# Gemini API Integration (Leave empty to use intelligent seeded realistic demo engine)
GEMINI_API_KEY=

# Application Mode
DEMO_MODE=true
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
